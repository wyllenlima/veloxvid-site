# Cabeçalhos dos arquivos estáticos (Cloudflare Workers).
# HTML, CSS e JS ficam com o padrão do Cloudflare: o navegador sempre confere
# se há versão nova (ETag), então uma publicação aparece na hora.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Fontes: nunca mudam de conteúdo sem mudar de nome.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens: 30 dias. Ao trocar uma imagem, use um nome de arquivo novo.
/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/video/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800

# A área da conta não deve aparecer na busca.
/conta
  X-Robots-Tag: noindex
